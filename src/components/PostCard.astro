---
import type { CollectionEntry } from 'astro:content';
import { formatDateShort } from '../lib/posts';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
---

<li class="post-item">
  <div class="post-line">
    <time class="post-date" datetime={post.data.pubDate.toISOString().slice(0, 10)}>
      {formatDateShort(post.data.pubDate)}
    </time>
    <h2 class="post-title">
      <a href={`/blog/${post.id}/`}>{post.data.title}</a>
    </h2>
    <span class="post-category">{post.data.category}</span>
  </div>
  {post.data.description && <p class="post-desc">{post.data.description}</p>}
  {post.data.tags.length > 0 && (
    <div class="post-tags">
      {post.data.tags.map((tag) => (
        <a class="tag" href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}</a>
      ))}
    </div>
  )}
</li>
