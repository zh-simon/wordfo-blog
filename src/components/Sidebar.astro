---
import { getPublishedPosts, countBy } from '../lib/posts';
import { getKeywords } from '../lib/keywords';
import { SITE_DESCRIPTION } from '../consts';

const posts = await getPublishedPosts();
const categories = countBy(posts, (post) => (post.data.category ? [post.data.category] : []));
const keywords = getKeywords(posts);
const maxCount = keywords.length > 0 ? keywords[0][1] : 1;
---

<aside class="sidebar" aria-label="站点侧栏">
  <section class="side-block">
    <h2 class="side-title">关于</h2>
    <p class="side-about">{SITE_DESCRIPTION}</p>
    <a class="side-more" href="/about/">了解更多 →</a>
  </section>

  {categories.length > 0 && (
    <section class="side-block">
      <h2 class="side-title">分类</h2>
      <ul class="side-list">
        {categories.map(([name, count]) => (
          <li>
            <a href={`/categories/${encodeURIComponent(name)}/`}>{name}</a>
            <span class="side-count">{count}</span>
          </li>
        ))}
      </ul>
    </section>
  )}

  {keywords.length > 0 && (
    <section class="side-block">
      <h2 class="side-title">词云</h2>
      <div class="word-cloud">
        {keywords.map(([word, count]) => {
          const level = count === maxCount ? 3 : count >= 2 ? 2 : 1;
          return <span class={`cloud-tag s${level}`} title={`出现在 ${count} 篇文章`}>{word}</span>;
        })}
      </div>
    </section>
  )}
</aside>
