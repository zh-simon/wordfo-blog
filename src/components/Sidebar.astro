---
import { getPublishedPosts, countBy } from '../lib/posts';
import { getWordCloud } from '../lib/keywords';
import { SIDE_ABOUT } from '../consts';

const posts = await getPublishedPosts();
const categories = countBy(posts, (post) => (post.data.category ? [post.data.category] : []));
const words = getWordCloud(posts);
---

<aside class="sidebar" aria-label="站点侧栏">
  <section class="side-block">
    <h2 class="side-title">关于</h2>
    <p class="side-about">{SIDE_ABOUT}</p>
    <a class="side-more" href="/about/">了解更多 →</a>
  </section>

  {categories.length > 0 && (
    <section class="side-block">
      <h2 class="side-title">分类</h2>
      <ul class="side-list">
        {categories.map(([name, count]) => (
          <li>
            <a href={`/categories/${encodeURIComponent(name)}/`}>{name}</a>
            <span class="side-count">{count}</span>
          </li>
        ))}
      </ul>
    </section>
  )}

  {words.length > 0 && (
    <section class="side-block">
      <h2 class="side-title">词云</h2>
      <div class="word-cloud">
        {words.map((w) => (
          <span
            class="cloud-tag"
            title={`出现在 ${w.count} 篇文章`}
            style={`left:${w.x}px;top:${w.y}px;font-size:${w.size}px;transform:rotate(${w.rotate}deg)${w.size >= 21 ? ';color:var(--fg);font-weight:600' : ''}`}
          >{w.word}</span>
        ))}
      </div>
    </section>
  )}
</aside>
