---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = (await getCollection('posts', ({ data }) => !data.draft))
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  return posts.map((post, i) => ({
    params: { id: post.id },
    props: {
      post,
      newer: i > 0 ? posts[i - 1] : null,
      older: i < posts.length - 1 ? posts[i + 1] : null,
    },
  }));
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="article">
    <header class="article-header">
      <div class="article-meta">
        <a href={`/categories/${encodeURIComponent(post.data.category)}/`}>{post.data.category}</a>
        <time datetime={post.data.pubDate.toISOString().slice(0, 10)}>
          {formatDate(post.data.pubDate)}
        </time>
        {post.data.updatedDate && <span>更新于 {formatDate(post.data.updatedDate)}</span>}
      </div>
      <h1>{post.data.title}</h1>
    </header>
    <div class="article-body">
      <Content />
    </div>

    {post.data.tags.length > 0 && (
      <div class="article-tags">
        {post.data.tags.map((tag) => (
          <a class="tag" href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}</a>
        ))}
      </div>
    )}

    <p class="back-line"><a class="back-link" href="/blog/">← 返回文章列表</a></p>

    {(newer || older) && (
      <nav class="post-nav" aria-label="文章导航">
        {newer ? (
          <a class="post-nav-item" href={`/blog/${newer.id}/`}>
            <span class="post-nav-label">← 更新的</span>
            <span class="post-nav-title">{newer.data.title}</span>
          </a>
        ) : <span class="post-nav-empty" aria-hidden="true"></span>}
        {older ? (
          <a class="post-nav-item next" href={`/blog/${older.id}/`}>
            <span class="post-nav-label">更早的 →</span>
            <span class="post-nav-title">{older.data.title}</span>
          </a>
        ) : <span class="post-nav-empty" aria-hidden="true"></span>}
      </nav>
    )}
  </article>
</BaseLayout>
