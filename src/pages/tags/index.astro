---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts, countBy } from '../../lib/posts';

const posts = await getPublishedPosts();
const tags = countBy(posts, (post) => post.data.tags);
---

<BaseLayout title="标签" description="按标签浏览全部文章">
  <section class="hero">
    <h1>标签</h1>
    <p>{tags.length} 个标签</p>
  </section>
  {tags.length > 0 ? (
    <div class="index-grid">
      {tags.map(([name, count]) => (
        <a class="index-cell" href={`/tags/${encodeURIComponent(name)}/`}>
          <span>#{name}</span>
          <span class="index-count">{count}</span>
        </a>
      ))}
    </div>
  ) : (
    <p class="empty">还没有标签。</p>
  )}
</BaseLayout>
